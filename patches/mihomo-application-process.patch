@@ -0,0 +1,87 @@
+package sing_tun
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"strings"
+	"sync"
+	"time"
+)
+
+type platformDNS struct {
+	command *exec.Cmd
+	input   io.WriteCloser
+	done    chan error
+	once    sync.Once
+}
+
+func (d *platformDNS) Close() error {
+	d.once.Do(func() {
+		d.input.Close()
+		d.command.Process.Kill()
+		<-d.done
+	})
+	return nil
+}
+
+func configurePlatformDNS(name string, servers []string) (io.Closer, error) {
+	if len(servers) == 0 {
+		return nil, nil
+	}
+	command := exec.Command("/usr/sbin/scutil")
+	input, err := command.StdinPipe()
+	if err != nil {
+		return nil, err
+	}
+	output, err := command.StdoutPipe()
+	if err != nil {
+		input.Close()
+		return nil, err
+	}
+	command.Stderr = command.Stdout
+	if err = command.Start(); err != nil {
+		input.Close()
+		return nil, err
+	}
+	d := &platformDNS{command: command, input: input, done: make(chan error, 1)}
+	ready := make(chan error, 1)
+	go func() {
+		scanner := bufio.NewScanner(output)
+		for scanner.Scan() {
+			line := scanner.Text()
+			if strings.Contains(line, "ClashVergeDNSReady : yes") {
+				select {
+				case ready <- nil:
+				default:
+				}
+			}
+			if strings.Contains(line, "Permission denied") {
+				select {
+				case ready <- fmt.Errorf("macOS refused the temporary TUN DNS resolver"):
+				default:
+				}
+			}
+		}
+		d.done <- command.Wait()
+	}()
+	key := fmt.Sprintf("State:/Network/Service/ClashVergeTunDNS-%d-%s/DNS", os.Getpid(), name)
+	// A temporary value disappears with scutil's session, including after a core crash.
+	commands := fmt.Sprintf("d.init\nd.add ServerAddresses * %s\nd.add SupplementalMatchDomains * \"\"\nd.add SupplementalMatchDomainsNoSearch # 1\nd.add SearchOrder # 1\nd.add InterfaceName %s\nd.add ClashVergeDNSReady yes\nadd %s temporary\nshow %s\n", strings.Join(servers, " "), name, key, key)
+	if _, err = io.WriteString(input, commands); err != nil {
+		d.Close()
+		return nil, err
+	}
+	select {
+	case err = <-ready:
+		if err == nil {
+			return d, nil
+		}
+	case <-time.After(3 * time.Second):
+		err = fmt.Errorf("macOS did not confirm the temporary TUN DNS resolver")
+	}
+	d.Close()
+	return nil, err
+}
