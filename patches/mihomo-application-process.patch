+func TestApplicationSubscriptionRoutingAndGlobalFallback(t *testing.T) {
+	policy := ApplicationProcess{Fallback: "global", GlobalMode: "rule", TunOnly: true, Applications: []ApplicationPolicy{{Path: testApplicationPath("/Applications/Browser.app"), Kind: "bundle", Enabled: true, Mode: "rule", Rules: "subscription-B", Proxy: "B-Exit"}}}
+	data, _ := json.Marshal(policy)
+	rule, err := NewApplicationProcess(base64.RawURLEncoding.EncodeToString(data), "DIRECT")
+	if err != nil {
+		t.Fatal(err)
+	}
+	metadata := &C.Metadata{Type: C.HTTP, ProcessPath: testApplicationPath("/Applications/Browser.app/Contents/MacOS/Browser")}
+	if matched, _ := rule.Match(metadata, C.RuleMatchHelper{}); matched || metadata.ApplicationRuleSet != "" {
+		t.Fatal("system proxy must use global defaults")
+	}
+	metadata.Type = C.TUN
+	if matched, _ := rule.Match(metadata, C.RuleMatchHelper{}); matched || metadata.ApplicationRuleSet != "subscription-B" || metadata.ApplicationRuleProxy != "B-Exit" {
+		t.Fatal("TUN app must select its own subscription rules and node")
+	}
+	metadata.ProcessPath = testApplicationPath("/unconfigured/process")
+	if matched, _ := rule.Match(metadata, C.RuleMatchHelper{}); matched {
+		t.Fatal("unconfigured TUN traffic must use global rules")
+	}
+	rule.GlobalMode = "global"
+	if matched, target := rule.Match(metadata, C.RuleMatchHelper{}); !matched || target != "GLOBAL" {
+		t.Fatal("unconfigured traffic must honor global proxy mode")
+	}
+	rule.GlobalMode = "direct"
+	if matched, target := rule.Match(metadata, C.RuleMatchHelper{}); !matched || target != "DIRECT" {
+		t.Fatal("unconfigured traffic must honor global direct mode")
+	}
+	metadata.ProcessPath = testApplicationPath("/Applications/Browser.app/Contents/MacOS/Browser")
+	rule.Applications[0].ProfileMissing = true
+	if matched, target := rule.Match(metadata, C.RuleMatchHelper{}); !matched || target != "REJECT" {
+		t.Fatal("removed subscription must not silently use another subscription")
+	}
+}
