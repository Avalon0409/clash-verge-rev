+			t.Fatalf("app-only TUN persistence: tun=%v profile=%v raw=%v", enabled, profile.StoreFakeIP, raw.Profile.StoreFakeIP)
+		}
+	}
+	raw := DefaultRawConfig()
+	raw.Tun.Enable = true
+	raw.DNS.Enable = true
+	raw.DNS.EnhancedMode = C.DNSFakeIP
+	profile, err := parseProfile(raw)
