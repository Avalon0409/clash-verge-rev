+func (g *dnsTestGroup) Unwrap(*C.Metadata, bool) C.Proxy { return g.leaf }
+
+func TestApplicationTargetDNSByLeaf(t *testing.T) {
+	previousRules, previousProxies, previousMode := rules, proxies, mode
+	t.Cleanup(func() {
+		rules, proxies, mode = previousRules, previousProxies, previousMode
+		resolver.SetApplicationDNS(nil)
+	})
+	main := &applicationDNSResolver{answer: netip.MustParseAddr("192.0.2.1")}
+	direct := &applicationDNSResolver{answer: netip.MustParseAddr("192.0.2.2")}
+	resolver.SetApplicationDNS(map[string]resolver.ApplicationResolvers{"sub": {Resolver: main, Direct: direct}})
+	group := &dnsTestGroup{}
+	proxies = map[string]C.Proxy{"group": group}
+	mode = Rule
+	cidr, err := common.NewIPCIDR("192.0.2.0/24", "group")
+	if err != nil {
+		t.Fatal(err)
+	}
+	rules = []C.Rule{cidr}
+	query := func() *C.Metadata {
+		m := &C.Metadata{Type: C.INNER, NetWork: C.TCP, Host: "leaf.example", ApplicationDNSProfile: "sub", ApplicationDNSProxy: "exit"}
+		_, _, err := resolveMetadata(m)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return m
+	}
+	group.leaf = &applicationDNSProbe{name: "exit"}
+	if m := query(); m.DstIP != main.answer || main.calls != 1 {
+		t.Fatalf("proxy should reuse rule IP: %s, calls=%d", m.DstIP, main.calls)
+	}
+	group.leaf = &dnsTestLeaf{kind: C.Direct}
+	if m := query(); m.DstIP != direct.answer || direct.calls != 1 {
+		t.Fatalf("group/direct: %s, calls=%d", m.DstIP, direct.calls)
+	}
+	rules = []C.Rule{common.NewMatch("group")}
+	group.leaf = &dnsTestLeaf{kind: C.RejectDrop}
+	if m := query(); m.Resolved() || main.calls != 2 || direct.calls != 1 {
+		t.Fatalf("rejected destination triggered lookup: %v", m.DstIP)
+	}
+}
