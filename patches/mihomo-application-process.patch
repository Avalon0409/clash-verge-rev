+
+type applicationContextKey struct{}
+
+type applicationContextClient struct {
+	dnsClient
+	seen any
+}
+
+func (c *applicationContextClient) Address() string { return "application-context-test" }
+func (c *applicationContextClient) ExchangeContext(ctx context.Context, query *D.Msg) (*D.Msg, error) {
+	c.seen = ctx.Value(applicationContextKey{})
+	reply := new(D.Msg)
+	reply.SetReply(query)
+	reply.Answer = []D.RR{&D.A{
+		Hdr: D.RR_Header{Name: query.Question[0].Name, Rrtype: D.TypeA, Class: D.ClassINET, Ttl: 60},
+		A:   net.IPv4(192, 0, 2, 1),
+	}}
+	return reply, nil
+}
+
+func TestApplicationDNSContextSurvivesSingleflight(t *testing.T) {
+	client := &applicationContextClient{}
+	r := NewResolverFromClient(client)
+	ctx := context.WithValue(context.Background(), applicationContextKey{}, "selected-subscription")
+	if _, err := r.LookupIPv4(ctx, "application.example"); err != nil {
+		t.Fatal(err)
+	}
+	if client.seen != "selected-subscription" {
+		t.Fatalf("DNS transport lost application context: %v", client.seen)
+	}
+}
+
+type applicationNoAddressClient struct {
+	dnsClient
+	rcode int
+}
+
+func (c *applicationNoAddressClient) Address() string { return "no-address-test" }
+func (*applicationNoAddressClient) ResetConnection()  {}
+func (c *applicationNoAddressClient) ExchangeContext(_ context.Context, query *D.Msg) (*D.Msg, error) {
+	reply := new(D.Msg)
+	reply.SetRcode(query, c.rcode)
+	return reply, nil
+}
+
+func TestNoAddressErrorRetainsDNSDetails(t *testing.T) {
+	for _, rcode := range []int{D.RcodeNameError, D.RcodeSuccess} {
+		r := NewResolverFromClient(&applicationNoAddressClient{rcode: rcode})
+		_, err := r.LookupIP(context.Background(), "missing.application.example")
+		if !errors.Is(err, resolver.ErrIPNotFound) || !strings.Contains(err.Error(), "missing.application.example") ||
+			!strings.Contains(err.Error(), D.RcodeToString[rcode]) || !strings.Contains(err.Error(), "AAAA") {
+			t.Fatalf("lost the failed DNS name, response code or IP-family error: %v", err)
+		}
+	}
+}
+
+type applicationIPv6Client struct{ dnsClient }
+
+func (*applicationIPv6Client) Address() string { return "ipv6-only-test" }
+func (*applicationIPv6Client) ExchangeContext(ctx context.Context, query *D.Msg) (*D.Msg, error) {
+	reply := new(D.Msg)
+	reply.SetReply(query)
+	if query.Question[0].Qtype == D.TypeAAAA {
+		select {
+		case <-time.After(180 * time.Millisecond):
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+		reply.Answer = []D.RR{&D.AAAA{Hdr: D.RR_Header{Name: query.Question[0].Name, Rrtype: D.TypeAAAA, Class: D.ClassINET, Ttl: 60}, AAAA: net.ParseIP("2001:db8::1")}}
+	}
+	return reply, nil
+}
+
+func TestIPv4NoDataWaitsForIPv6WithinDeadline(t *testing.T) {
+	r := NewResolverFromClient(&applicationIPv6Client{})
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	ips, err := r.LookupIP(ctx, "ipv6-only.application.example")
+	if err != nil || len(ips) != 1 || ips[0].String() != "2001:db8::1" {
+		t.Fatalf("IPv4 no-data discarded a valid delayed AAAA answer: %v %v", ips, err)
+	}
+	r = NewResolverFromClient(&applicationIPv6Client{})
+	short, stop := context.WithTimeout(context.Background(), 40*time.Millisecond)
+	defer stop()
+	_, err = r.LookupIP(short, "deadline.application.example")
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("waiting for AAAA must honor the caller deadline: %v", err)
+	}
+}
