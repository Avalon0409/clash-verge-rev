+	if err != nil {
+		return info, nil
+	}
+	info.StartTime = current.StartTime
+	seen := map[uint32]bool{pid: true}
+	for parent > 1 && !seen[parent] {
+		seen[parent] = true
+		ancestor, next, err := processIdentity(parent)
+		if err != nil {
+			break
+		}
+		info.Ancestors = append(info.Ancestors, ancestor)
+		parent = next
+	}
+	return info, nil
