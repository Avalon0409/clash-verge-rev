+
+func TestApplicationProcessInheritanceAndInstanceOverride(t *testing.T) {
+	policy := ApplicationProcess{Applications: []ApplicationPolicy{{Path: testApplicationPath("/Applications/IDE.app"), Kind: "bundle", Enabled: true, Proxy: "Exit"}}, Overrides: []ProcessOverride{{PID: 20, StartTime: 100, Enabled: false}}}
+	bytes, _ := json.Marshal(policy)
+	rule, err := NewApplicationProcess(base64.RawURLEncoding.EncodeToString(bytes), "DIRECT")
+	if err != nil {
+		t.Fatal(err)
+	}
+	metadata := &C.Metadata{ProcessID: 30, ProcessStartTime: 200, ProcessPath: testApplicationPath("/sdk/qemu"), ProcessAncestors: []C.ProcessIdentity{{PID: 20, StartTime: 100, Path: testApplicationPath("/sdk/emulator")}, {PID: 10, StartTime: 50, Path: testApplicationPath("/Applications/IDE.app/Contents/MacOS/IDE")}}}
+	_, target := rule.Match(metadata, C.RuleMatchHelper{})
+	if target != "DIRECT" {
+		t.Fatalf("child must inherit its parent's temporary override: %s", target)
+	}
+	metadata.ProcessAncestors[0].StartTime = 101
+	_, target = rule.Match(metadata, C.RuleMatchHelper{})
+	if target != "Exit" {
+		t.Fatalf("reused PID must fall back to app settings: %s", target)
+	}
+	metadata.ProcessID = 20
+	metadata.ProcessStartTime = 100
+	_, target = rule.Match(metadata, C.RuleMatchHelper{})
+	if target != "DIRECT" {
+		t.Fatalf("temporary override must apply to its own process: %s", target)
+	}
+	metadata.ProcessID = 21
+	_, target = rule.Match(metadata, C.RuleMatchHelper{})
+	if target != "Exit" {
+		t.Fatalf("same executable with a different PID must inherit normally: %s", target)
+	}
+	metadata.ProcessAncestors = nil
+	_, target = rule.Match(metadata, C.RuleMatchHelper{})
+	if target != "DIRECT" {
+		t.Fatalf("unrelated process must be direct: %s", target)
+	}
+}
+
+func TestApplicationRuleModeContinuesSubscriptionRules(t *testing.T) {
+	policy := ApplicationProcess{Applications: []ApplicationPolicy{{Path: testApplicationPath("/Applications/Browser.app"), Kind: "bundle", Enabled: true, Mode: "rule", Proxy: "SelectedExit"}}}
+	bytes, _ := json.Marshal(policy)
+	payload := base64.RawURLEncoding.EncodeToString(bytes)
+	metadata := &C.Metadata{ProcessPath: testApplicationPath("/Applications/Browser.app/Contents/MacOS/Browser")}
+	for _, adapter := range []string{"DIRECT", "REJECT"} {
+		rule, err := NewApplicationProcess(payload, adapter)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if matched, _ := rule.Match(metadata, C.RuleMatchHelper{}); matched {
+			t.Fatal("rule-mode app must continue to subscription rules")
+		}
+		if metadata.ApplicationRuleProxy != "SelectedExit" {
+			t.Fatal("rule mode must retain the app-specific proxy selection")
+		}
+	}
+	policy.Applications[0].Mode = "proxy"
+	policy.Applications[0].Proxy = "Exit"
+	bytes, _ = json.Marshal(policy)
+	payload = base64.RawURLEncoding.EncodeToString(bytes)
+	rule, _ := NewApplicationProcess(payload, "DIRECT")
+	if matched, target := rule.Match(metadata, C.RuleMatchHelper{}); !matched || target != "Exit" {
+		t.Fatal("proxy mode must force its target")
+	}
+	guard, _ := NewApplicationProcess(payload, "REJECT")
+	if matched, target := guard.Match(metadata, C.RuleMatchHelper{}); !matched || target != "REJECT" {
+		t.Fatal("unsupported forced-proxy UDP must reject instead of using subscription rules")
+	}
+	policy.Applications[0].Enabled = false
+	bytes, _ = json.Marshal(policy)
+	rule, _ = NewApplicationProcess(base64.RawURLEncoding.EncodeToString(bytes), "DIRECT")
+	if matched, target := rule.Match(metadata, C.RuleMatchHelper{}); !matched || target != "DIRECT" {
+		t.Fatal("disabled app must bypass subscription rules")
+	}
+}
+
+func TestBundledHelpersInheritParentInstanceOverride(t *testing.T) {
+	r := &ApplicationProcess{adapter: "DIRECT", Applications: []ApplicationPolicy{{Path: testApplicationPath("/Applications/Browser.app"), Kind: "bundle", Enabled: true, Proxy: "Exit"}}, Overrides: []ProcessOverride{{PID: 10, StartTime: 100, Enabled: false}}}
+	metadata := &C.Metadata{ProcessID: 20, ProcessStartTime: 200, ProcessPath: testApplicationPath("/Applications/Browser.app/Contents/MacOS/Helper"), ProcessAncestors: []C.ProcessIdentity{{PID: 10, StartTime: 100, Path: testApplicationPath("/Applications/Browser.app/Contents/MacOS/Browser")}}}
+	_, target := r.Match(metadata, C.RuleMatchHelper{})
+	if target != "DIRECT" {
+		t.Fatal("bundled helper must follow its parent's temporary override")
+	}
+}
+
+func TestApplicationSubscriptionRoutingAndGlobalFallback(t *testing.T) {
+	policy := ApplicationProcess{Fallback: "global", GlobalMode: "rule", TunOnly: true, Applications: []ApplicationPolicy{{Path: testApplicationPath("/Applications/Browser.app"), Kind: "bundle", Enabled: true, Mode: "rule", Rules: "subscription-B", Proxy: "B-Exit"}}}
+	data, _ := json.Marshal(policy)
+	rule, err := NewApplicationProcess(base64.RawURLEncoding.EncodeToString(data), "DIRECT")
+	if err != nil {
+		t.Fatal(err)
+	}
+	metadata := &C.Metadata{Type: C.HTTP, ProcessPath: testApplicationPath("/Applications/Browser.app/Contents/MacOS/Browser")}
+	if matched, _ := rule.Match(metadata, C.RuleMatchHelper{}); matched || metadata.ApplicationRuleSet != "" {
+		t.Fatal("system proxy must use global defaults")
+	}
+	metadata.Type = C.TUN
+	if matched, _ := rule.Match(metadata, C.RuleMatchHelper{}); matched || metadata.ApplicationRuleSet != "subscription-B" || metadata.ApplicationRuleProxy != "B-Exit" {
+		t.Fatal("TUN app must select its own subscription rules and node")
+	}
+	metadata.ProcessPath = testApplicationPath("/unconfigured/process")
+	if matched, _ := rule.Match(metadata, C.RuleMatchHelper{}); matched {
+		t.Fatal("unconfigured TUN traffic must use global rules")
+	}
+	rule.GlobalMode = "global"
+	if matched, target := rule.Match(metadata, C.RuleMatchHelper{}); !matched || target != "GLOBAL" {
+		t.Fatal("unconfigured traffic must honor global proxy mode")
+	}
+	rule.GlobalMode = "direct"
+	if matched, target := rule.Match(metadata, C.RuleMatchHelper{}); !matched || target != "DIRECT" {
+		t.Fatal("unconfigured traffic must honor global direct mode")
+	}
+	metadata.ProcessPath = testApplicationPath("/Applications/Browser.app/Contents/MacOS/Browser")
+	rule.Applications[0].ProfileMissing = true
+	if matched, target := rule.Match(metadata, C.RuleMatchHelper{}); !matched || target != "REJECT" {
+		t.Fatal("removed subscription must not silently use another subscription")
+	}
+}
