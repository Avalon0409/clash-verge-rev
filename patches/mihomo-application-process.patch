+
+func TestWindowsApplicationPathNormalization(t *testing.T) {
+	for _, path := range []string{`C:\Apps\Browser.exe`, `\\Server\Share\Browser.exe`} {
+		policy := ApplicationProcess{Applications: []ApplicationPolicy{{Path: path, Kind: "executable", Enabled: true, Mode: "proxy", Proxy: "Exit"}}}
+		data, _ := json.Marshal(policy)
+		rule, err := NewApplicationProcess(base64.RawURLEncoding.EncodeToString(data), "DIRECT")
+		if err != nil {
+			t.Fatal(err)
+		}
+		candidate := `\\?\c:/APPS/BROWSER.EXE`
+		if path[0] == '\\' {
+			candidate = `\\?\unc\SERVER\share\browser.exe`
+		}
+		if matched, target := rule.Match(&C.Metadata{ProcessPath: candidate}, C.RuleMatchHelper{}); !matched || target != "Exit" {
+			t.Fatalf("Windows paths must select the configured application: %s", target)
+		}
+	}
+}
