+package process
+
+import (
+	"net/netip"
+	"unsafe"
+
+	C "github.com/metacubex/mihomo/constant"
+	"golang.org/x/sys/windows"
+)
+
+func findProcessName(network string, ip netip.Addr, port int) (uint32, string, error) {
+	info, err := findProcessInfo(network, ip, port)
+	return info.UID, info.Path, err
+}
+
+func processIdentity(pid uint32) (C.ProcessIdentity, error) {
+	handle, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION, false, pid)
+	if err != nil {
+		return C.ProcessIdentity{}, err
+	}
+	defer windows.CloseHandle(handle)
+	var created, exited, kernel, user windows.Filetime
+	if err = windows.GetProcessTimes(handle, &created, &exited, &kernel, &user); err != nil {
+		return C.ProcessIdentity{}, err
+	}
+	path, err := getExecPathFromPID(pid)
+	if err != nil {
+		return C.ProcessIdentity{}, err
+	}
+	// Unix microseconds keep the FILETIME identity exact within JavaScript's integer range.
+	ticks := uint64(created.HighDateTime)<<32 | uint64(created.LowDateTime)
+	return C.ProcessIdentity{PID: pid, Path: path, StartTime: ticks/10 - 11644473600000000}, nil
+}
+
+func processParents() map[uint32]uint32 {
+	parents := make(map[uint32]uint32)
+	snapshot, err := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPPROCESS, 0)
+	if err != nil {
+		return parents
+	}
+	defer windows.CloseHandle(snapshot)
+	entry := windows.ProcessEntry32{Size: uint32(unsafe.Sizeof(windows.ProcessEntry32{}))}
+	for err = windows.Process32First(snapshot, &entry); err == nil; err = windows.Process32Next(snapshot, &entry) {
+		parents[entry.ProcessID] = entry.ParentProcessID
+	}
+	return parents
+}
+
+func findProcessInfo(network string, ip netip.Addr, port int) (Info, error) {
+	pid, path, err := findSocketProcess(network, ip, port)
+	if err != nil {
+		return Info{}, err
+	}
+	info := Info{Path: path, PID: pid}
+	current, err := processIdentity(pid)
+	if err != nil {
+		return info, nil
+	}
+	info.Path, info.StartTime = current.Path, current.StartTime
+	parents := processParents()
+	seen := map[uint32]bool{pid: true}
+	for parent := parents[pid]; parent > 0 && !seen[parent]; parent = parents[parent] {
+		seen[parent] = true
+		ancestor, err := processIdentity(parent)
+		if err != nil || ancestor.StartTime > current.StartTime {
+			break
+		}
+		info.Ancestors = append(info.Ancestors, ancestor)
+		current = ancestor
+	}
+	return info, nil
+}
