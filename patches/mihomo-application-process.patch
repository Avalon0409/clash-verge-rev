+func TestApplicationExitsDoNotReuseDoHConnections(t *testing.T) {
+	oldProxies, oldProviders, oldRules, oldRuleProviders, oldMode := tunnel.Proxies(), tunnel.Providers(), tunnel.Rules(), tunnel.RuleProviders(), tunnel.Mode()
+	t.Cleanup(func() {
+		tunnel.UpdateProxies(oldProxies, oldProviders)
+		tunnel.UpdateRules(oldRules, nil, oldRuleProviders)
+		tunnel.SetMode(oldMode)
+		resolver.SetApplicationDNS(nil)
+		ca.ResetCertificate()
+	})
+	var servers []*httptest.Server
+	var proxies = make(map[string]C.Proxy)
+	for i, name := range []string{"exit-A", "exit-B"} {
+		answer := net.IPv4(192, 0, 2, byte(i+1))
+		server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+			var payload []byte
+			var err error
+			if req.Method == http.MethodGet {
+				payload, err = base64.RawURLEncoding.DecodeString(req.URL.Query().Get("dns"))
+			} else {
+				payload, err = io.ReadAll(req.Body)
+			}
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			query := new(D.Msg)
+			if err = query.Unpack(payload); err != nil {
+				t.Error(err)
+				return
+			}
+			reply := new(D.Msg)
+			reply.SetReply(query)
+			reply.Answer = []D.RR{&D.A{Hdr: D.RR_Header{Name: query.Question[0].Name, Rrtype: D.TypeA, Class: D.ClassINET, Ttl: 60}, A: answer}}
+			payload, err = reply.Pack()
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			w.Header().Set("Content-Type", "application/dns-message")
+			_, _ = w.Write(payload)
+		}))
+		t.Cleanup(server.Close)
+		servers = append(servers, server)
+		if err := ca.AddCertificate(string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw}))); err != nil {
+			t.Fatal(err)
+		}
+		proxyServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+			if req.Method != http.MethodConnect {
+				http.Error(w, "CONNECT required", http.StatusMethodNotAllowed)
+				return
+			}
+			upstream, err := net.Dial("tcp", server.Listener.Addr().String())
+			if err != nil {
+				http.Error(w, err.Error(), http.StatusBadGateway)
+				return
+			}
+			conn, _, err := w.(http.Hijacker).Hijack()
+			if err != nil {
+				upstream.Close()
+				return
+			}
+			_, _ = io.WriteString(conn, "HTTP/1.1 200 Connection Established\r\n\r\n")
+			go func() { _, _ = io.Copy(upstream, conn); _ = upstream.Close() }()
+			_, _ = io.Copy(conn, upstream)
+			_ = conn.Close()
+		}))
+		t.Cleanup(proxyServer.Close)
+		host, portText, err := net.SplitHostPort(proxyServer.Listener.Addr().String())
+		if err != nil {
+			t.Fatal(err)
+		}
+		port, _ := strconv.Atoi(portText)
+		proxy, err := outbound.NewHttp(outbound.HttpOption{Name: name, Server: host, Port: port})
+		if err != nil {
+			t.Fatal(err)
+		}
+		proxies[name] = adapter.NewProxy(proxy)
+	}
+	tunnel.UpdateProxies(proxies, nil)
+	applicationRule, err := common.NewApplicationProcess(base64.RawURLEncoding.EncodeToString([]byte(`{"tun_only":true,"fallback":"direct","global_mode":"rule"}`)), "DIRECT")
+	if err != nil {
+		t.Fatal(err)
+	}
+	tunnel.UpdateRules([]C.Rule{applicationRule, common.NewMatch("exit-A")}, map[string][]C.Rule{"shared-subscription": {common.NewMatch("exit-A")}}, nil)
+	tunnel.SetMode(tunnel.Rule)
+	r := dns.NewResolver(dns.Config{Main: []dns.NameServer{{Net: "https", Addr: servers[0].URL + "/dns-query", ProxyName: tunnel.DnsRespectRules}}})
+	t.Cleanup(r.ResetConnection)
+	resolver.SetApplicationDNS(map[string]resolver.ApplicationResolvers{"shared-subscription": {Resolver: r}, resolver.GlobalDNSProfile: {Resolver: r}})
+	for profileIndex, profile := range []string{"shared-subscription", resolver.GlobalDNSProfile} {
+		for i, name := range []string{"exit-A", "exit-B"} {
+			ctx := resolver.WithApplicationDNS(context.Background(), profile, name)
+			ips, err := r.LookupIPv4(ctx, name+".profile-"+strconv.Itoa(profileIndex)+".application.example")
+			want := net.IPv4(192, 0, 2, byte(i+1)).String()
+			if err != nil || len(ips) != 1 || ips[0].String() != want {
+				t.Fatalf("DoH used another exit: profile=%s exit=%s got=%v want=%s error=%v", profile, name, ips, want, err)
+			}
+		}
+	}
+}
