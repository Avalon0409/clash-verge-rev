+package provider_test
+
+import (
+	"net/netip"
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/rules/provider"
+)
+
+func TestIPCidrStrategyAcceptsClassicalCIDRs(t *testing.T) {
+	for _, test := range []struct{ rule, address string }{
+		{"192.0.2.0/24", "192.0.2.1"},
+		{"IP-CIDR,192.0.2.0/24,no-resolve", "192.0.2.1"},
+		{"IP-CIDR6,2001:db8::/32,no-resolve", "2001:db8::1"},
+	} {
+		t.Run(test.rule, func(t *testing.T) {
+			strategy := provider.NewIPCidrStrategy()
+			strategy.Reset()
+			strategy.Insert(test.rule)
+			strategy.FinishInsert()
+			if strategy.Count() != 1 || !strategy.Match(&C.Metadata{DstIP: netip.MustParseAddr(test.address)}, C.RuleMatchHelper{}) {
+				t.Fatalf("CIDR was discarded: %s", test.rule)
+			}
+		})
+	}
+}
