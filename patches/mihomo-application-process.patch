+func (d *DNS) excludeTunDNS(path string, endpoints []netip.AddrPort) error {
+	filter := func(field string, servers *[]dns.NameServer) error {
+		isOwned := func(server dns.NameServer) bool {
+			address := server.Addr
+			if server.Net == "https" {
+				u, err := url.Parse(address)
+				if err != nil {
+					return false
+				}
+				address = u.Host
+			}
+			addr, err := netip.ParseAddrPort(address)
+			return err == nil && slices.Contains(endpoints, addr)
+		}
+		if !slices.ContainsFunc(*servers, isOwned) {
+			return nil
+		}
+		// Comma-separated policies share their parsed nameserver slice.
+		*servers = slices.DeleteFunc(slices.Clone(*servers), isOwned)
+		if len(*servers) == 0 {
+			return fmt.Errorf("%s.%s contains only TUN DNS endpoints", path, field)
+		}
+		return nil
+	}
+	for _, field := range []struct {
+		name    string
+		servers *[]dns.NameServer
+	}{
+		{"nameserver", &d.NameServer}, {"default-nameserver", &d.DefaultNameserver}, {"fallback", &d.Fallback},
+		{"proxy-server-nameserver", &d.ProxyServerNameserver}, {"direct-nameserver", &d.DirectNameServer},
+	} {
+		if err := filter(field.name, field.servers); err != nil {
+			return err
+		}
+	}
+	for _, field := range []struct {
+		name     string
+		policies []dns.Policy
+	}{
+		{"nameserver-policy", d.NameServerPolicy}, {"proxy-server-nameserver-policy", d.ProxyServerPolicy},
+	} {
+		for i := range field.policies {
+			p := &field.policies[i]
+			if err := filter(fmt.Sprintf("%s[%d:%s]", field.name, i, p.Domain), &p.NameServers); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
