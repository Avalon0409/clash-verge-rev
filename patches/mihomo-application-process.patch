+	ctx := resolver.WithApplicationDNS(context.Background(), resolver.GlobalDNSProfile, "selected")
+	_, _ = NewDNSDialer(nil, nil, DnsRespectRules).DialContext(ctx, "tcp", "192.0.2.53:53")
