+package resolver
+
+import (
+	"context"
+	"sync/atomic"
+)
+
+type ApplicationResolvers struct {
+	Resolver
+	Proxy  Resolver
+	Direct Resolver
+}
+
+type applicationDNSContextKey struct{}
+
+var applicationDNS atomic.Pointer[map[string]ApplicationResolvers]
+
+func SetApplicationDNS(values map[string]ApplicationResolvers) {
+	old := applicationDNS.Swap(&values)
+	if old != nil {
+		for _, r := range *old {
+			go r.ResetConnection()
+		}
+	}
+}
+
+func ApplicationDNS(profile string) Resolver {
+	values := applicationDNS.Load()
+	if values == nil {
+		return nil
+	}
+	return (*values)[profile].Resolver
+}
+
+func WithApplicationDNS(ctx context.Context, profile string) context.Context {
+	if values := applicationDNS.Load(); values != nil {
+		if r, ok := (*values)[profile]; ok {
+			return context.WithValue(ctx, applicationDNSContextKey{}, r)
+		}
+	}
+	return ctx
+}
+
+func applicationResolver(ctx context.Context, r Resolver) Resolver {
+	selected, ok := ctx.Value(applicationDNSContextKey{}).(ApplicationResolvers)
+	if !ok || r == nil {
+		return r
+	}
+	if r == ProxyServerHostResolver && selected.Proxy != nil {
+		return selected.Proxy
+	}
+	if r == DirectHostResolver && selected.Direct != nil {
+		return selected.Direct
+	}
+	return r
+}
