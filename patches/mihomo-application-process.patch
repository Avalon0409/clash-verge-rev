new file mode 100644
index 0000000..108c79c
--- /dev/null
+++ b/dns/application_scope.go
@@ -0,0 +1,81 @@
+package dns
+
+import (
+	"context"
+	"sync"
+
+	"github.com/metacubex/mihomo/component/resolver"
+)
+
+type resolverRole uint8
+
+const (
+	mainResolver resolverRole = iota
+	proxyResolver
+	directResolver
+	defaultResolver
+)
+
+type resolverScope struct{ profile, proxy string }
+
+type resolverScopes struct {
+	mu      sync.Mutex
+	build   func() Resolvers
+	entries map[resolverScope]Resolvers
+}
+
+func (rs Resolvers) withScopes(build func() Resolvers) Resolvers {
+	scopes := &resolverScopes{build: build, entries: make(map[resolverScope]Resolvers)}
+	for role, r := range []*Resolver{rs.Resolver, rs.ProxyResolver, rs.DirectResolver, rs.Resolver.defaultResolver} {
+		if r != nil {
+			r.scopes, r.role = scopes, resolverRole(role)
+		}
+	}
+	return rs
+}
+
+func (rs Resolvers) forRole(role resolverRole) *Resolver {
+	switch role {
+	case proxyResolver:
+		return rs.ProxyResolver
+	case directResolver:
+		return rs.DirectResolver
+	case defaultResolver:
+		return rs.Resolver.defaultResolver
+	default:
+		return rs.Resolver
+	}
+}
+
+func (r *Resolver) forContext(ctx context.Context) *Resolver {
+	if r == nil || r.scopes == nil {
+		return r
+	}
+	profile, proxy := resolver.ApplicationDNSRoute(ctx)
+	if profile == "" && proxy == "" {
+		return r
+	}
+	key := resolverScope{profile: profile, proxy: proxy}
+	r.scopes.mu.Lock()
+	defer r.scopes.mu.Unlock()
+	values, exists := r.scopes.entries[key]
+	if !exists {
+		// DoH and DoQ connections stay bound to the exit used by their first query.
+		values = r.scopes.build()
+		r.scopes.entries[key] = values
+	}
+	return values.forRole(r.role)
+}
+
+func (r *Resolver) scopedResolvers() []*Resolver {
+	if r == nil || r.scopes == nil {
+		return nil
+	}
+	r.scopes.mu.Lock()
+	defer r.scopes.mu.Unlock()
+	values := make([]*Resolver, 0, len(r.scopes.entries))
+	for _, entry := range r.scopes.entries {
+		values = append(values, entry.forRole(r.role))
+	}
+	return values
+}
