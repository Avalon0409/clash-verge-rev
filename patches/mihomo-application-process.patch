+	native := dns.NameServer{Addr: "198.19.8.3:53"}
+	shared := []dns.NameServer{captured, native}
+	config := DNS{NameServer: shared, NameServerPolicy: []dns.Policy{{Domain: "shared.test", NameServers: shared}, {Domain: "corp.test", NameServers: []dns.NameServer{{Addr: "[fd00::2]:53"}}}}}
+	err := config.excludeTunDNS("application-dns[sub]", tun.DNSEndpoints())
