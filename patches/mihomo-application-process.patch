+func TestSocketIdentityIncludesExactProcessInstance(t *testing.T) {
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	connection, err := net.Dial("tcp4", listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connection.Close()
+	address := connection.LocalAddr().(*net.TCPAddr)
+	ip, _ := netip.AddrFromSlice(address.IP)
+	info, err := findProcessInfo(TCP, ip.Unmap(), address.Port)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.PID != uint32(os.Getpid()) || info.StartTime == 0 || info.Path == "" {
+		t.Fatalf("missing socket owner identity: pid=%d start=%d", info.PID, info.StartTime)
+	}
+	identity, _, err := processIdentity(uint32(os.Getpid()))
+	if err != nil || identity.StartTime != info.StartTime {
+		t.Fatalf("inconsistent process identity: %v", err)
+	}
+}
