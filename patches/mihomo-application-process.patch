+package resolver
+
+import (
+	"context"
+	"errors"
+	"net/netip"
+	"testing"
+	"time"
+)
+
+type applicationTestResolver struct {
+	Resolver
+	calls  int
+	lookup func(context.Context, string) ([]netip.Addr, error)
+}
+
+func (r *applicationTestResolver) Invalid() bool { return true }
+func (r *applicationTestResolver) LookupIPv4(ctx context.Context, host string) ([]netip.Addr, error) {
+	r.calls++
+	return r.lookup(ctx, host)
+}
+
+func TestApplicationDNSUsesSystemOnlyAfterSubscriptionFails(t *testing.T) {
+	primary := &applicationTestResolver{lookup: func(ctx context.Context, host string) ([]netip.Addr, error) {
+		return []netip.Addr{netip.MustParseAddr("192.0.2.1")}, nil
+	}}
+	system := &applicationTestResolver{lookup: func(ctx context.Context, host string) ([]netip.Addr, error) {
+		return []netip.Addr{netip.MustParseAddr("192.0.2.2")}, nil
+	}}
+	r := WithSystemFallback(primary, system)
+	ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
+	defer cancel()
+	ips, err := r.LookupIPv4(ctx, "same.example")
+	if err != nil || ips[0].String() != "192.0.2.1" || system.calls != 0 {
+		t.Fatalf("primary answer must win without querying system DNS: %v %v", ips, err)
+	}
+	primary.lookup = func(ctx context.Context, host string) ([]netip.Addr, error) { return nil, ErrIPNotFound }
+	ips, err = r.LookupIPv4(ctx, "same.example")
+	if err != nil || ips[0].String() != "192.0.2.2" || system.calls != 1 {
+		t.Fatalf("system DNS must handle failed subscription queries: %v %v", ips, err)
+	}
+	primary.lookup = func(ctx context.Context, host string) ([]netip.Addr, error) { <-ctx.Done(); return nil, ctx.Err() }
+	ips, err = r.LookupIPv4(ctx, "same.example")
+	if err != nil || ips[0].String() != "192.0.2.2" || system.calls != 2 {
+		t.Fatalf("primary timeout must leave time for system DNS: %v %v", ips, err)
+	}
+	cancelled, stop := context.WithCancel(context.Background())
+	stop()
+	_, err = r.LookupIPv4(cancelled, "same.example")
+	if !errors.Is(err, context.Canceled) || system.calls != 2 {
+		t.Fatal("cancelled requests must not start fallback DNS queries")
+	}
+}
