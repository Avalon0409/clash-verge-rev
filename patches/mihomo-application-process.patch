@@ -0,0 +1,40 @@
+package dns
+
+import (
+	"context"
+	"net"
+	"testing"
+
+	D "github.com/miekg/dns"
+)
+
+type applicationContextKey struct{}
+
+type applicationContextClient struct {
+	dnsClient
+	seen any
+}
+
+func (c *applicationContextClient) Address() string { return "application-context-test" }
+func (c *applicationContextClient) ExchangeContext(ctx context.Context, query *D.Msg) (*D.Msg, error) {
+	c.seen = ctx.Value(applicationContextKey{})
+	reply := new(D.Msg)
+	reply.SetReply(query)
+	reply.Answer = []D.RR{&D.A{
+		Hdr: D.RR_Header{Name: query.Question[0].Name, Rrtype: D.TypeA, Class: D.ClassINET, Ttl: 60},
+		A:   net.IPv4(192, 0, 2, 1),
+	}}
+	return reply, nil
+}
+
+func TestApplicationDNSContextSurvivesSingleflight(t *testing.T) {
+	client := &applicationContextClient{}
+	r := NewResolverFromClient(client)
+	ctx := context.WithValue(context.Background(), applicationContextKey{}, "selected-subscription")
+	if _, err := r.LookupIPv4(ctx, "application.example"); err != nil {
+		t.Fatal(err)
+	}
+	if client.seen != "selected-subscription" {
+		t.Fatalf("DNS transport lost application context: %v", client.seen)
+	}
+}
