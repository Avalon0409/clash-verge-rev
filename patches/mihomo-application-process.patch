new file mode 100644
index 0000000..68b76e5
--- /dev/null
+++ b/component/iface/route_windows_test.go
@@ -0,0 +1,37 @@
+package iface
+
+import (
+	"encoding/binary"
+	"net"
+	"net/netip"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+func TestNativeWindowsRouteUsesInterfaceMetric(t *testing.T) {
+	rows := []ipForwardRow{
+		{Index: 1, Destination: ipAddressPrefix{Address: windows.RawSockaddrInet6{Family: windows.AF_INET}}},
+		{Index: 2, Destination: ipAddressPrefix{Address: windows.RawSockaddrInet6{Family: windows.AF_INET}}},
+		{Index: 3, Metric: 5, Destination: ipAddressPrefix{Address: windows.RawSockaddrInet6{Family: windows.AF_INET}}},
+	}
+	interfaces := map[string]*Interface{
+		"Mihomo":   {Index: 1, Name: "Mihomo", Flags: net.FlagUp},
+		"Ethernet": {Index: 2, Name: "Ethernet", Flags: net.FlagUp},
+		"Wi-Fi":    {Index: 3, Name: "Wi-Fi", Flags: net.FlagUp},
+	}
+	metrics := map[uint32]uint32{1: 0, 2: 80, 3: 10}
+	metric := func(_ uint16, index uint32) uint32 { return metrics[index] }
+	got := selectRouteInterface(rows, interfaces, netip.MustParseAddr("1.1.1.1"), "Mihomo", metric)
+	if got == nil || got.Name != "Wi-Fi" {
+		t.Fatalf("expected lowest combined metric on a native interface, got %v", got)
+	}
+	address := netip.MustParseAddr("203.0.113.0").As4()
+	rows = append(rows, ipForwardRow{Index: 2, Metric: 500, Destination: ipAddressPrefix{
+		Address: windows.RawSockaddrInet6{Family: windows.AF_INET, Flowinfo: binary.LittleEndian.Uint32(address[:])}, Length: 24,
+	}})
+	got = selectRouteInterface(rows, interfaces, netip.MustParseAddr("203.0.113.1"), "Mihomo", metric)
+	if got == nil || got.Name != "Ethernet" {
+		t.Fatalf("the longest native route must win before metrics, got %v", got)
+	}
+}
