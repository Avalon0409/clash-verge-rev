+	reply := new(D.Msg)
+	reply.SetReply(query)
+	reply.Answer = []D.RR{&D.A{
+		Hdr: D.RR_Header{Name: query.Question[0].Name, Rrtype: D.TypeA, Class: D.ClassINET, Ttl: 60},
+		A:   net.IPv4(192, 0, 2, last),
+	}}
+	return reply, nil
+}
+
+func TestSubscriptionCacheSeparatesSelectedExits(t *testing.T) {
+	client := &applicationExitDNSClient{}
+	r := NewResolverFromClient(client)
+	resolver.SetApplicationDNS(map[string]resolver.ApplicationResolvers{"shared-subscription": {Resolver: r}})
+	t.Cleanup(func() { resolver.SetApplicationDNS(nil) })
+	for i, exit := range []string{"exit-A", "exit-B"} {
+		ctx := resolver.WithApplicationDNS(context.Background(), "shared-subscription", exit)
+		ips, err := r.LookupIPv4(ctx, "geo.application.example")
+		want := net.IPv4(192, 0, 2, byte(i+1)).String()
+		if err != nil || len(ips) != 1 || ips[0].String() != want {
+			t.Fatalf("DNS exit %s reused another exit's answer: got=%v want=%s calls=%d error=%v", exit, ips, want, client.calls.Load(), err)
+		}
+	}
+	ctx := resolver.WithApplicationDNS(context.Background(), "shared-subscription", "exit-A")
+	_, _ = r.LookupIPv4(ctx, "geo.application.example")
+	if client.calls.Load() != 2 {
+		t.Fatal("an unchanged exit should retain its own DNS cache")
+	}
+	r.ClearCache()
+	_, _ = r.LookupIPv4(ctx, "geo.application.example")
+	if client.calls.Load() != 3 {
+		t.Fatal("clearing DNS caches must include application exits")
+	}
+}
+
+func TestSelectedExitsDoNotShareInflightQueries(t *testing.T) {
+	client := &applicationExitDNSClient{started: make(chan string, 2), gate: make(chan struct{})}
+	r := NewResolverFromClient(client)
+	resolver.SetApplicationDNS(map[string]resolver.ApplicationResolvers{"shared-subscription": {Resolver: r}})
+	t.Cleanup(func() { resolver.SetApplicationDNS(nil) })
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	results := make(chan []netip.Addr, 2)
+	for _, exit := range []string{"exit-A", "exit-B"} {
+		selected := resolver.WithApplicationDNS(ctx, "shared-subscription", exit)
+		go func() { ips, _ := r.LookupIPv4(selected, "concurrent.application.example"); results <- ips }()
+	}
+	for i := 0; i < 2; i++ {
+		select {
+		case <-client.started:
+		case <-ctx.Done():
+			close(client.gate)
+			t.Fatal("different application exits joined the same in-flight DNS query")
+		}
+	}
+	close(client.gate)
+	answers := make(map[string]bool)
+	for i := 0; i < 2; i++ {
+		ips := <-results
+		if len(ips) != 1 {
+			t.Fatalf("missing concurrent DNS reply: %v", ips)
+		}
+		answers[ips[0].String()] = true
+	}
+	if !answers["192.0.2.1"] || !answers["192.0.2.2"] {
+		t.Fatalf("concurrent queries lost their selected exits: %v", answers)
+	}
+}
+
+func TestSystemUpstreamUsesNativeResolverAcrossAppExits(t *testing.T) {
+	client := &applicationExitDNSClient{}
+	native := NewResolverFromClient(client)
+	sub := NewResolver(Config{Main: []NameServer{{Net: "rcode", Addr: "name_error"}}, Policy: []Policy{{Domain: "+.corp.example", NameServers: []NameServer{{Net: "system"}}}}, Native: native})
+	resolver.SetApplicationDNS(map[string]resolver.ApplicationResolvers{"sub": {Resolver: sub}})
+	t.Cleanup(func() { resolver.SetApplicationDNS(nil) })
+	for _, exit := range []string{"exit-A", "exit-B"} {
+		ctx := resolver.WithApplicationDNS(context.Background(), "sub", exit)
+		ips, err := sub.LookupIPv4(ctx, "office.corp.example")
+		if err != nil || len(ips) != 1 || ips[0].String() != "192.0.2.1" {
+			t.Fatalf("native answer: %v %v", ips, err)
+		}
+	}
+	if client.calls.Load() != 1 {
+		t.Fatalf("native upstream queries: %d", client.calls.Load())
+	}
+}
