+type countingSystemDNS struct {
+	resolver.Resolver
+	calls atomic.Int32
+}
+
+func (s *countingSystemDNS) LookupIPv4(context.Context, string) ([]netip.Addr, error) {
+	s.calls.Add(1)
+	return []netip.Addr{netip.MustParseAddr("192.0.2.2")}, nil
+}
+
+func TestSubscriptionLookupHonorsDeadline(t *testing.T) {
+	pc, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ready := make(chan struct{})
+	stop := make(chan struct{})
+	server := &D.Server{PacketConn: pc, NotifyStartedFunc: func() { close(ready) }, Handler: D.HandlerFunc(func(w D.ResponseWriter, q *D.Msg) {
+		select {
+		case <-time.After(3 * time.Second):
+		case <-stop:
+			return
+		}
+		m := new(D.Msg)
+		m.SetReply(q)
+		m.Answer = []D.RR{&D.A{Hdr: D.RR_Header{Name: q.Question[0].Name, Rrtype: D.TypeA, Class: D.ClassINET, Ttl: 60}, A: net.IPv4(192, 0, 2, 1)}}
+		if q.Question[0].Name != "origin.example." {
+			m.Answer = nil
+		}
+		_ = w.WriteMsg(m)
+	})}
+	go server.ActivateAndServe()
+	<-ready
+	defer func() { close(stop); _ = server.Shutdown() }()
+	system := &countingSystemDNS{Resolver: resolver.SystemResolver}
+	previous := resolver.SystemResolver
+	resolver.SystemResolver = system
+	defer func() { resolver.SetApplicationDNS(nil); resolver.SystemResolver = previous }()
+	cfg := &config.Config{General: &config.General{}, DNS: &config.DNS{}, ApplicationDNS: map[string]*config.DNS{"subscription": {Enable: true, NameServer: []dns.NameServer{{Addr: pc.LocalAddr().String()}}}}}
+	table := trie.New[resolver.HostValue]()
+	if err := table.Insert("slow.example", resolver.HostValue{IsDomain: true, Domain: "origin.example"}); err != nil {
+		t.Fatal(err)
+	}
+	cfg.ApplicationHosts = map[string]*trie.DomainTrie[resolver.HostValue]{"subscription": table}
+	updateApplicationDNS(cfg)
+	for _, tc := range []struct {
+		name   string
+		budget time.Duration
+	}{{"slow.example", 5 * time.Second}, {"timeout.example", 30 * time.Millisecond}} {
+		ctx, cancel := context.WithTimeout(resolver.WithApplicationDNS(context.Background(), "subscription", "exit"), tc.budget)
+		ips, err := resolver.LookupIPv4WithResolver(ctx, tc.name, resolver.ApplicationTargetDNS(ctx, false))
+		cancel()
+		if tc.budget < time.Second {
+			if !errors.Is(err, context.DeadlineExceeded) {
+				t.Fatalf("subscription deadline: %v", err)
+			}
+		} else if err != nil || len(ips) != 1 || ips[0] != netip.MustParseAddr("192.0.2.1") {
+			t.Fatalf("subscription answer: %v, %v", ips, err)
+		}
+	}
+	if system.calls.Load() != 0 {
+		t.Fatalf("system queries: %d", system.calls.Load())
+	}
+}
