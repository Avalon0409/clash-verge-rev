+package tunnel
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/metacubex/mihomo/component/resolver"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/rules/common"
+)
+
+type applicationDNSProbe struct {
+	C.Proxy
+	name   string
+	called bool
+}
+
+func (p *applicationDNSProbe) Name() string                     { return p.name }
+func (p *applicationDNSProbe) Type() C.AdapterType              { return C.Socks5 }
+func (p *applicationDNSProbe) Unwrap(*C.Metadata, bool) C.Proxy { return nil }
+func (p *applicationDNSProbe) IsL3Protocol(*C.Metadata) bool    { return false }
+func (p *applicationDNSProbe) DialContext(context.Context, *C.Metadata) (C.Conn, error) {
+	p.called = true
+	return nil, errors.New("DNS route probe")
+}
+
+type applicationDNSResolver struct{ resolver.Resolver }
+
+func (*applicationDNSResolver) ResetConnection() {}
+
+func TestApplicationDNSRespectRulesUsesSubscription(t *testing.T) {
+	oldRules, oldSubRules, oldProxies, oldMode := rules, subRules, proxies, mode
+	t.Cleanup(func() {
+		rules, subRules, proxies, mode = oldRules, oldSubRules, oldProxies, oldMode
+		resolver.SetApplicationDNS(nil)
+	})
+	global := &applicationDNSProbe{name: "global"}
+	subscription := &applicationDNSProbe{name: "subscription"}
+	selected := &applicationDNSProbe{name: "selected"}
+	proxies = map[string]C.Proxy{"global": global, "subscription": subscription, "selected": selected}
+	rules = []C.Rule{common.NewMatch("global")}
+	subRules = map[string][]C.Rule{"application-dns": {common.NewMatch("subscription")}}
+	mode = Rule
+	resolver.SetApplicationDNS(map[string]resolver.ApplicationResolvers{
+		"application-dns": {Resolver: &applicationDNSResolver{}},
+	})
+	ctx := resolver.WithApplicationDNS(context.Background(), "application-dns")
+	_, _ = NewDNSDialer(nil, nil, DnsRespectRules).DialContext(ctx, "tcp", "192.0.2.53:53")
+	if global.called || !subscription.called {
+		t.Fatalf("DNS used the wrong route: global=%v subscription=%v", global.called, subscription.called)
+	}
+	subscription.called = false
+	ctx = resolver.WithApplicationDNS(context.Background(), "application-dns", "selected")
+	_, _ = NewDNSDialer(nil, nil, DnsRespectRules).DialContext(ctx, "tcp", "192.0.2.53:53")
+	if global.called || subscription.called || !selected.called {
+		t.Fatal("subscription DNS must use the application's selected proxy")
+	}
+}
