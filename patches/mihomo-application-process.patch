+}
+func (c senderTestConn) SetReadDeadline(at time.Time) error { return c.socket.SetReadDeadline(at) }
+func (c senderTestConn) ResolveUDP(ctx context.Context, m *C.Metadata) error {
+	var err error
+	m.DstIP, err = resolver.ResolveIPWithResolver(ctx, m.Host, resolver.DirectHostResolver)
+	return err
+}
+
+func TestUDPSenderUsesAppResolverForSecondDestination(t *testing.T) {
+	receiver, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer receiver.Close()
+	dest := receiver.LocalAddr().(*net.UDPAddr).AddrPort()
+	first := &C.Metadata{NetWork: C.UDP, DstIP: dest.Addr(), DstPort: dest.Port()}
+	main := &applicationDNSResolver{answer: dest.Addr()}
+	previous := resolver.DirectHostResolver
+	resolver.DirectHostResolver = &applicationDNSResolver{answer: netip.MustParseAddr("127.0.0.2")}
+	resolver.SetApplicationDNS(map[string]resolver.ApplicationResolvers{"sub": {Resolver: main, Direct: main}})
+	defer func() { resolver.SetApplicationDNS(nil); resolver.DirectHostResolver = previous }()
+	socket, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer socket.Close()
+	pc := senderTestConn{socket: socket}
+	sender := newPacketSender()
+	sender.AddMapping(first, first)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		sender.Process(resolver.WithApplicationDNS(sender.Context(), "sub", "exit"), pc, nil)
+	}()
+	defer func() { sender.Close(); <-done }()
+	for _, m := range []*C.Metadata{first, {NetWork: C.UDP, Host: "second.application.example", DstPort: dest.Port()}} {
+		sender.Send(senderTestPacket{dest: m})
+		_ = receiver.SetReadDeadline(time.Now().Add(time.Second))
+		var buf [16]byte
+		if _, _, err = receiver.ReadFromUDP(buf[:]); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
