diff --git a/component/iface/route_darwin.go b/component/iface/route_darwin.go
new file mode 100644
index 0000000..a72a5d5
--- /dev/null
+++ b/component/iface/route_darwin.go
@@ -0,0 +1,74 @@
+package iface
+
+import (
+	"net"
+	"net/netip"
+	"time"
+
+	"github.com/metacubex/mihomo/common/singledo"
+	"golang.org/x/net/route"
+	"golang.org/x/sys/unix"
+)
+
+var routeCache = singledo.NewSingle[[]route.Message](time.Second)
+
+// ResolveRouteInterface follows the OS route while excluding routes installed by this TUN.
+func ResolveRouteInterface(destination netip.Addr, excluded string) *Interface {
+	if !destination.IsValid() || destination.IsLoopback() {
+		return nil
+	}
+	messages, err, _ := routeCache.Do(func() ([]route.Message, error) {
+		rib, err := route.FetchRIB(unix.AF_UNSPEC, route.RIBTypeRoute, 0)
+		if err != nil {
+			return nil, err
+		}
+		return route.ParseRIB(route.RIBTypeRoute, rib)
+	})
+	if err != nil {
+		return nil
+	}
+	interfaces, err := Interfaces()
+	if err != nil {
+		return nil
+	}
+	var best *Interface
+	bestBits := -1
+	for _, message := range messages {
+		row, ok := message.(*route.RouteMessage)
+		if !ok || row.Flags&unix.RTF_UP == 0 || row.Flags&(unix.RTF_REJECT|unix.RTF_BLACKHOLE) != 0 || len(row.Addrs) <= unix.RTAX_NETMASK {
+			continue
+		}
+		var network netip.Addr
+		var mask net.IPMask
+		switch address := row.Addrs[unix.RTAX_DST].(type) {
+		case *route.Inet4Addr:
+			network = netip.AddrFrom4(address.IP)
+			if value, ok := row.Addrs[unix.RTAX_NETMASK].(*route.Inet4Addr); ok {
+				mask = net.IPMask(value.IP[:])
+			}
+		case *route.Inet6Addr:
+			network = netip.AddrFrom16(address.IP)
+			if value, ok := row.Addrs[unix.RTAX_NETMASK].(*route.Inet6Addr); ok {
+				mask = net.IPMask(value.IP[:])
+			}
+		default:
+			continue
+		}
+		bits, size := mask.Size()
+		if row.Flags&unix.RTF_HOST != 0 {
+			bits = network.BitLen()
+		} else if size != network.BitLen() {
+			continue
+		}
+		if network.Is4() != destination.Is4() || bits <= bestBits || !netip.PrefixFrom(network, bits).Contains(destination) {
+			continue
+		}
+		for _, iface := range interfaces {
+			if iface.Index == row.Index && iface.Name != excluded && iface.Flags&net.FlagLoopback == 0 && iface.Flags&net.FlagUp != 0 {
+				best, bestBits = iface, bits
+				break
+			}
+		}
+	}
+	return best
+}
