+
+func processIdentity(pid uint32) (C.ProcessIdentity, uint32, error) {
+	buf := make([]byte, 136)
+	size, _, errno := syscall.Syscall6(syscall.SYS_PROC_INFO, proccallnumpidinfo, uintptr(pid), 3, 0, uintptr(unsafe.Pointer(&buf[0])), uintptr(len(buf)))
+	if errno != 0 {
+		return C.ProcessIdentity{}, 0, errno
+	}
+	if size != uintptr(len(buf)) {
+		return C.ProcessIdentity{}, 0, ErrNotFound
+	}
+	path, err := getExecPathFromPID(pid)
+	if err != nil {
+		return C.ProcessIdentity{}, 0, err
+	}
+	return C.ProcessIdentity{PID: pid, Path: path, StartTime: binary.NativeEndian.Uint64(buf[120:128])*1000000 + binary.NativeEndian.Uint64(buf[128:136])}, binary.NativeEndian.Uint32(buf[16:20]), nil
+}
+
+func findProcessInfo(network string, ip netip.Addr, port int) (Info, error) {
+	pid, path, err := findSocketProcess(network, ip, port)
+	if err != nil {
+		return Info{}, err
+	}
+	info := Info{Path: path, PID: pid}
+	current, parent, err := processIdentity(pid)
+	if err != nil {
+		return info, nil
+	}
+	info.StartTime = current.StartTime
+	seen := map[uint32]bool{pid: true}
+	for parent > 1 && !seen[parent] {
+		seen[parent] = true
+		ancestor, next, err := processIdentity(parent)
+		if err != nil {
+			break
+		}
+		info.Ancestors = append(info.Ancestors, ancestor)
+		parent = next
+	}
+	return info, nil
+}
