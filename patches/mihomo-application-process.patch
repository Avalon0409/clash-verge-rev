new file mode 100644
index 0000000..ba7677d
--- /dev/null
+++ b/component/resolver/application_dns.go
@@ -0,0 +1,131 @@
+package resolver
+
+import (
+	"context"
+	"errors"
+	"net/netip"
+	"sync/atomic"
+	"time"
+)
+
+const SystemDNSProfile = "__system_dns"
+const GlobalDNSProfile = "__global_dns"
+
+type ApplicationResolvers struct {
+	Resolver
+	Proxy   Resolver
+	Direct  Resolver
+	Hosts   *Hosts
+	profile string
+	proxy   string
+}
+
+type applicationDNSContextKey struct{}
+
+var applicationDNS atomic.Pointer[map[string]ApplicationResolvers]
+
+func SetApplicationDNS(values map[string]ApplicationResolvers) {
+	old := applicationDNS.Swap(&values)
+	if old != nil {
+		for _, r := range *old {
+			go r.ResetConnection()
+		}
+	}
+}
+
+func ApplicationDNS(profile string) Resolver {
+	if profile == SystemDNSProfile {
+		return SystemResolver
+	}
+	values := applicationDNS.Load()
+	if values == nil {
+		return nil
+	}
+	return (*values)[profile].Resolver
+}
+
+func WithApplicationDNS(ctx context.Context, profile string, proxy ...string) context.Context {
+	if profile == SystemDNSProfile {
+		return context.WithValue(ctx, applicationDNSContextKey{}, ApplicationResolvers{Resolver: SystemResolver, Proxy: SystemResolver, Direct: SystemResolver})
+	}
+	if values := applicationDNS.Load(); values != nil {
+		if r, ok := (*values)[profile]; ok {
+			r.profile = profile
+			if len(proxy) != 0 {
+				r.proxy = proxy[0]
+			}
+			return context.WithValue(ctx, applicationDNSContextKey{}, r)
+		}
+	}
+	return ctx
+}
+
+func ApplicationDNSRoute(ctx context.Context) (profile, proxy string) {
+	if selected, ok := ctx.Value(applicationDNSContextKey{}).(ApplicationResolvers); ok && selected.profile != GlobalDNSProfile {
+		return selected.profile, selected.proxy
+	}
+	return "", ""
+}
+
+func applicationResolver(ctx context.Context, r Resolver) Resolver {
+	selected, ok := ctx.Value(applicationDNSContextKey{}).(ApplicationResolvers)
+	if !ok || r == nil {
+		return r
+	}
+	if r == ProxyServerHostResolver && selected.Proxy != nil {
+		return selected.Proxy
+	}
+	if r == DirectHostResolver && selected.Direct != nil {
+		return selected.Direct
+	}
+	return r
+}
+
+type applicationFallbackResolver struct {
+	Resolver
+	system Resolver
+}
+
+func WithSystemFallback(primary, system Resolver) Resolver {
+	if primary == nil || !primary.Invalid() {
+		return system
+	}
+	return &applicationFallbackResolver{Resolver: primary, system: system}
+}
+
+func (r *applicationFallbackResolver) lookup(ctx context.Context, host string, primary, system func(context.Context, string) ([]netip.Addr, error)) ([]netip.Addr, error) {
+	budget := DefaultDNSTimeout / 2
+	if deadline, ok := ctx.Deadline(); ok {
+		budget = time.Until(deadline) / 2
+	}
+	preferred, cancel := context.WithTimeout(ctx, budget)
+	ips, err := primary(preferred, host)
+	cancel()
+	if err == nil && len(ips) != 0 {
+		return ips, nil
+	}
+	if ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	if errors.Is(err, ErrIPv6Disabled) {
+		return nil, err
+	}
+	return system(ctx, host)
+}
+
+func (r *applicationFallbackResolver) LookupIP(ctx context.Context, host string) ([]netip.Addr, error) {
+	return r.lookup(ctx, host, r.Resolver.LookupIP, r.system.LookupIP)
+}
+func (r *applicationFallbackResolver) LookupIPv4(ctx context.Context, host string) ([]netip.Addr, error) {
+	return r.lookup(ctx, host, r.Resolver.LookupIPv4, r.system.LookupIPv4)
+}
+func (r *applicationFallbackResolver) LookupIPv6(ctx context.Context, host string) ([]netip.Addr, error) {
+	return r.lookup(ctx, host, r.Resolver.LookupIPv6, r.system.LookupIPv6)
+}
+
+func applicationHosts(ctx context.Context) *Hosts {
+	if selected, ok := ctx.Value(applicationDNSContextKey{}).(ApplicationResolvers); ok && selected.Hosts != nil {
+		return selected.Hosts
+	}
+	return &DefaultHosts
+}
