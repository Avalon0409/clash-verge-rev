diff --git a/rules/common/application_process.go b/rules/common/application_process.go
new file mode 100644
index 0000000..c959760
--- /dev/null
+++ b/rules/common/application_process.go
@@ -0,0 +1,175 @@
+package common
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"github.com/metacubex/mihomo/component/resolver"
+	C "github.com/metacubex/mihomo/constant"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strings"
+)
+
+type ApplicationPolicy struct {
+	Path           string `json:"path"`
+	Kind           string `json:"kind"`
+	Enabled        bool   `json:"enabled"`
+	Mode           string `json:"mode"`
+	Rules          string `json:"rules"`
+	ProfileMissing bool   `json:"profile_missing"`
+	Proxy          string `json:"proxy"`
+}
+
+type ProcessOverride struct {
+	PID            uint32 `json:"pid"`
+	StartTime      uint64 `json:"start_time"`
+	Enabled        bool   `json:"enabled"`
+	Mode           string `json:"mode"`
+	Rules          string `json:"rules"`
+	ProfileMissing bool   `json:"profile_missing"`
+	Proxy          string `json:"proxy"`
+}
+
+type ApplicationProcess struct {
+	Base
+	payload      string
+	adapter      string
+	Applications []ApplicationPolicy `json:"applications"`
+	Overrides    []ProcessOverride   `json:"overrides"`
+	Fallback     string              `json:"fallback"`
+	GlobalMode   string              `json:"global_mode"`
+	TunOnly      bool                `json:"tun_only"`
+}
+
+func (r *ApplicationProcess) Payload() string      { return r.payload }
+func (r *ApplicationProcess) Adapter() string      { return r.adapter }
+func (r *ApplicationProcess) RuleType() C.RuleType { return C.ApplicationProcess }
+
+func (r *ApplicationProcess) route(metadata *C.Metadata, enabled bool, mode, proxy, rules string, missing bool) (bool, string) {
+	if !enabled {
+		metadata.ApplicationDNSProfile = resolver.SystemDNSProfile
+		return true, "DIRECT"
+	}
+	if missing {
+		return true, "REJECT"
+	}
+	metadata.ApplicationDNSProfile = rules
+	metadata.ApplicationDNSProxy = proxy
+	if rules == "" {
+		metadata.ApplicationDNSProfile = resolver.GlobalDNSProfile
+	}
+	if enabled && mode == "rule" {
+		metadata.ApplicationRuleSet = rules
+		metadata.ApplicationRuleProxy = proxy
+		return false, ""
+	}
+	if enabled && r.adapter == "REJECT" {
+		return true, "REJECT"
+	}
+	return true, outbound(enabled, proxy)
+}
+
+func (r *ApplicationProcess) globalFallback() (bool, string) {
+	switch r.GlobalMode {
+	case "global":
+		return true, "GLOBAL"
+	case "direct":
+		return true, "DIRECT"
+	default:
+		return false, ""
+	}
+}
+
+func (r *ApplicationProcess) fallback() (bool, string) {
+	if r.Fallback == "global" {
+		return r.globalFallback()
+	}
+	return true, "DIRECT"
+}
+
+func outbound(enabled bool, proxy string) string {
+	if !enabled {
+		return "DIRECT"
+	}
+	if proxy == "" || proxy == "PASS" || proxy == "GLOBAL" || proxy == "REJECT-DROP" {
+		return "REJECT"
+	}
+	return proxy
+}
+
+func (r *ApplicationProcess) Match(metadata *C.Metadata, helper C.RuleMatchHelper) (bool, string) {
+	metadata.ApplicationRuleProxy = ""
+	metadata.ApplicationRuleSet = ""
+	metadata.ApplicationDNSProfile = ""
+	metadata.ApplicationDNSProxy = ""
+	if r.TunOnly && metadata.Type != C.TUN {
+		metadata.ApplicationDNSProfile = resolver.GlobalDNSProfile
+		return r.globalFallback()
+	}
+	if r.Fallback != "global" {
+		metadata.ApplicationDNSProfile = resolver.SystemDNSProfile
+	}
+	if helper.FindProcess != nil {
+		helper.FindProcess()
+	}
+	identities := append([]C.ProcessIdentity{{PID: metadata.ProcessID, StartTime: metadata.ProcessStartTime, Path: metadata.ProcessPath}}, metadata.ProcessAncestors...)
+	var bundle *ApplicationPolicy
+	for _, identity := range identities {
+		for _, override := range r.Overrides {
+			if identity.PID != 0 && identity.StartTime != 0 && override.PID == identity.PID && override.StartTime == identity.StartTime {
+				return r.route(metadata, override.Enabled, override.Mode, override.Proxy, override.Rules, override.ProfileMissing)
+			}
+		}
+		for i := range r.Applications {
+			application := &r.Applications[i]
+			if application.Kind == "executable" && applicationPath(identity.Path) == applicationPath(application.Path) {
+				return r.route(metadata, application.Enabled, application.Mode, application.Proxy, application.Rules, application.ProfileMissing)
+			}
+			if bundle == nil && application.Kind == "bundle" && strings.HasPrefix(identity.Path, application.Path+"/") {
+				bundle = application
+			}
+		}
+	}
+	if bundle != nil {
+		return r.route(metadata, bundle.Enabled, bundle.Mode, bundle.Proxy, bundle.Rules, bundle.ProfileMissing)
+	}
+	return r.fallback()
+}
+
+func NewApplicationProcess(payload, adapter string) (*ApplicationProcess, error) {
+	bytes, err := base64.RawURLEncoding.DecodeString(payload)
+	if err != nil {
+		return nil, err
+	}
+	rule := &ApplicationProcess{payload: payload, adapter: adapter}
+	if err = json.Unmarshal(bytes, rule); err != nil {
+		return nil, err
+	}
+	for _, app := range rule.Applications {
+		if !filepath.IsAbs(app.Path) || app.Kind != "bundle" && app.Kind != "executable" || app.Mode != "" && app.Mode != "rule" && app.Mode != "proxy" {
+			return nil, fmt.Errorf("invalid application process policy")
+		}
+	}
+	for _, override := range rule.Overrides {
+		if override.PID == 0 || override.StartTime == 0 || override.Mode != "" && override.Mode != "rule" && override.Mode != "proxy" {
+			return nil, fmt.Errorf("invalid process identity")
+		}
+	}
+	sort.SliceStable(rule.Applications, func(i, j int) bool { return len(rule.Applications[i].Path) > len(rule.Applications[j].Path) })
+	return rule, nil
+}
+
+func applicationPath(path string) string {
+	if runtime.GOOS != "windows" {
+		return path
+	}
+	path = strings.ToLower(strings.ReplaceAll(path, `\`, "/"))
+	if strings.HasPrefix(path, "//?/unc/") {
+		path = "//" + path[len("//?/unc/"):]
+	} else {
+		path = strings.TrimPrefix(path, "//?/")
+	}
+	return path
+}
