+package resolver
+
+import (
+	"context"
+	"sync/atomic"
+)
+
+const SystemDNSProfile = "__system_dns"
+const GlobalDNSProfile = "__global_dns"
+
+type ApplicationResolvers struct {
+	Resolver
+	Proxy   Resolver
+	Direct  Resolver
+	Hosts   *Hosts
+	profile string
+	proxy   string
+}
+
+type applicationDNSContextKey struct{}
+
+var applicationDNS atomic.Pointer[map[string]ApplicationResolvers]
+
+func SetApplicationDNS(values map[string]ApplicationResolvers) {
+	old := applicationDNS.Swap(&values)
+	if old != nil {
+		for _, r := range *old {
+			go r.ResetConnection()
+		}
+	}
+}
+
+func ApplicationDNS(profile string) Resolver {
+	if values := applicationDNS.Load(); values != nil {
+		return (*values)[profile].Resolver
+	}
+	return nil
+}
+
+func ApplicationTargetDNS(ctx context.Context, direct bool) Resolver {
+	selected, _ := ctx.Value(applicationDNSContextKey{}).(ApplicationResolvers)
+	if direct && selected.Direct != nil {
+		return selected.Direct
+	}
+	return selected.Resolver
+}
+
+func WithApplicationDNS(ctx context.Context, profile string, proxy ...string) context.Context {
+	if values := applicationDNS.Load(); values != nil {
+		if r, ok := (*values)[profile]; ok {
+			r.profile = profile
+			if len(proxy) != 0 {
+				r.proxy = proxy[0]
+			}
+			return context.WithValue(ctx, applicationDNSContextKey{}, r)
+		}
+	}
+	return ctx
+}
+
+func WithNativeDNS(ctx context.Context) context.Context {
+	return context.WithValue(ctx, applicationDNSContextKey{}, ApplicationResolvers{})
+}
+
+func ApplicationDNSRoute(ctx context.Context) (profile, proxy string) {
+	if selected, ok := ctx.Value(applicationDNSContextKey{}).(ApplicationResolvers); ok {
+		if selected.profile != GlobalDNSProfile && selected.profile != SystemDNSProfile {
+			profile = selected.profile
+		}
+		return profile, selected.proxy
+	}
+	return "", ""
+}
+
+func applicationResolver(ctx context.Context, r Resolver) Resolver {
+	selected, ok := ctx.Value(applicationDNSContextKey{}).(ApplicationResolvers)
+	if !ok || r == nil {
+		return r
+	}
+	if r == ProxyServerHostResolver && selected.Proxy != nil {
+		return selected.Proxy
+	}
+	if r == DirectHostResolver && selected.Direct != nil {
+		return selected.Direct
+	}
+	if r == DefaultResolver && selected.Resolver != nil {
+		return selected.Resolver
+	}
+	return r
+}
+
+func lookupApplicationHost(ctx context.Context, host string) (string, *HostValue) {
+	hosts := &DefaultHosts
+	if selected, ok := ctx.Value(applicationDNSContextKey{}).(ApplicationResolvers); ok && selected.Hosts != nil {
+		hosts = selected.Hosts
+	}
+	node, matched := hosts.Search(host, false)
+	if matched {
+		return host, node
+	}
+	if hosts != &DefaultHosts && node != nil && node.IsDomain {
+		return node.Domain, nil
+	}
+	return host, nil
+}
