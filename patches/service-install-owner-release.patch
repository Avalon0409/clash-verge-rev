+#[cfg(all(test, target_os = "macos"))]
+mod owner_release_tests {
+    use super::*;
+    use std::os::fd::AsRawFd as _;
+
+    #[test]
+    fn waits_for_stopped_owner_release_and_preserves_other_refusals() -> Result<(), Error> {
+        let path = std::env::temp_dir().join(format!("service-owner-release-{}", std::process::id()));
+        let holder = OpenOptions::new().read(true).write(true).create_new(true).open(&path)?;
+        assert_eq!(
+            unsafe { platform_lib::flock(holder.as_raw_fd(), platform_lib::LOCK_EX | platform_lib::LOCK_NB) },
+            0
+        );
+        let contender = OpenOptions::new().read(true).write(true).open(&path)?;
+        let acquire = || {
+            if unsafe { platform_lib::flock(contender.as_raw_fd(), platform_lib::LOCK_EX | platform_lib::LOCK_NB) } != 0
+            {
+                return Err(std::io::Error::last_os_error()).context("owner still stopping");
+            }
+            Ok(())
+        };
+        assert!(wait_for_stopped_owner(acquire, Duration::ZERO).is_err());
+        let release = std::thread::spawn(move || {
+            std::thread::sleep(Duration::from_millis(50));
+            drop(holder);
+        });
+        let result = wait_for_stopped_owner(acquire, Duration::from_secs(2));
+        release.join().expect("release thread panicked");
+        drop(contender);
+        std::fs::remove_file(path)?;
+        result?;
+        let denied = wait_for_stopped_owner(
+            || Err::<(), _>(std::io::Error::from(std::io::ErrorKind::PermissionDenied).into()),
+            Duration::from_secs(2),
+        )
+        .expect_err("permission failures must remain failures");
+        assert_eq!(
+            denied.downcast_ref::<std::io::Error>().unwrap().kind(),
+            std::io::ErrorKind::PermissionDenied
+        );
+        Ok(())
+    }
+}
