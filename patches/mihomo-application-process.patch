diff --git a/component/iface/route_windows.go b/component/iface/route_windows.go
new file mode 100644
index 0000000..77d08af
--- /dev/null
+++ b/component/iface/route_windows.go
@@ -0,0 +1,107 @@
+package iface
+
+import (
+	"encoding/binary"
+	"net"
+	"net/netip"
+	"syscall"
+	"time"
+	"unsafe"
+
+	"github.com/metacubex/mihomo/common/singledo"
+	"golang.org/x/sys/windows"
+)
+
+var ipHelper = syscall.NewLazyDLL("iphlpapi.dll")
+var getIPForwardTable = ipHelper.NewProc("GetIpForwardTable2")
+var getIPInterfaceEntry = ipHelper.NewProc("GetIpInterfaceEntry")
+var freeMIBTable = ipHelper.NewProc("FreeMibTable")
+var routeCache = singledo.NewSingle[[]ipForwardRow](time.Second)
+
+type ipAddressPrefix struct {
+	Address windows.RawSockaddrInet6
+	Length  uint8
+}
+type ipForwardRow struct {
+	LUID                                               uint64
+	Index                                              uint32
+	Destination                                        ipAddressPrefix
+	NextHop                                            windows.RawSockaddrInet6
+	SitePrefixLength                                   uint8
+	ValidLifetime, PreferredLifetime, Metric, Protocol uint32
+	Loopback, Autoconfigure, Publish, Immortal         uint8
+	Age, Origin                                        uint32
+}
+type ipForwardTable struct {
+	Count uint32
+	// MIB_IPFORWARD_TABLE2 aligns its rows to eight bytes on both Windows targets.
+	_    uint32
+	Rows [1]ipForwardRow
+}
+
+func ResolveRouteInterface(destination netip.Addr, excluded string) *Interface {
+	if !destination.IsValid() || destination.IsLoopback() {
+		return nil
+	}
+	rows, err, _ := routeCache.Do(func() ([]ipForwardRow, error) {
+		var table *ipForwardTable
+		status, _, _ := getIPForwardTable.Call(windows.AF_UNSPEC, uintptr(unsafe.Pointer(&table)))
+		if status != 0 {
+			return nil, syscall.Errno(status)
+		}
+		defer freeMIBTable.Call(uintptr(unsafe.Pointer(table)))
+		return append([]ipForwardRow(nil), unsafe.Slice(&table.Rows[0], table.Count)...), nil
+	})
+	if err != nil {
+		return nil
+	}
+	interfaces, err := Interfaces()
+	if err != nil {
+		return nil
+	}
+	metrics := make(map[[2]uint32]uint32)
+	return selectRouteInterface(rows, interfaces, destination, excluded, func(family uint16, index uint32) uint32 {
+		key := [2]uint32{uint32(family), index}
+		if metric, ok := metrics[key]; ok {
+			return metric
+		}
+		entry := windows.MibIpInterfaceRow{Family: family, InterfaceIndex: index}
+		if status, _, _ := getIPInterfaceEntry.Call(uintptr(unsafe.Pointer(&entry))); status != 0 {
+			return 0
+		}
+		metrics[key] = entry.Metric
+		return entry.Metric
+	})
+}
+
+func selectRouteInterface(rows []ipForwardRow, interfaces map[string]*Interface, destination netip.Addr, excluded string, interfaceMetric func(uint16, uint32) uint32) *Interface {
+	var best *Interface
+	bestBits, bestMetric := -1, ^uint64(0)
+	for _, row := range rows {
+		var network netip.Addr
+		switch row.Destination.Address.Family {
+		case windows.AF_INET:
+			var address [4]byte
+			binary.LittleEndian.PutUint32(address[:], row.Destination.Address.Flowinfo)
+			network = netip.AddrFrom4(address)
+		case windows.AF_INET6:
+			network = netip.AddrFrom16(row.Destination.Address.Addr)
+		default:
+			continue
+		}
+		bits := int(row.Destination.Length)
+		if network.Is4() != destination.Is4() || bits < bestBits || !netip.PrefixFrom(network, bits).Contains(destination) {
+			continue
+		}
+		for _, iface := range interfaces {
+			if uint32(iface.Index) == row.Index && iface.Name != excluded && iface.Flags&net.FlagLoopback == 0 && iface.Flags&net.FlagUp != 0 {
+				metric := uint64(row.Metric) + uint64(interfaceMetric(row.Destination.Address.Family, row.Index))
+				if bits > bestBits || metric < bestMetric {
+					best, bestBits, bestMetric = iface, bits, metric
+				}
+				break
+			}
+		}
+	}
+	return best
+}
