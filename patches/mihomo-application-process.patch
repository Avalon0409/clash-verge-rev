+func (c *FakeIpStore) Mappings(prefix netip.Prefix) map[string]netip.Addr {
+	values := make(map[string]netip.Addr)
+	if c.DB == nil {
+		return values
+	}
+	_ = c.DB.View(func(t *bbolt.Tx) error {
+		if bucket := t.Bucket(c.bucketName); bucket != nil {
+			return bucket.ForEach(func(key, value []byte) error {
+				if ip, ok := netip.AddrFromSlice(value); ok && prefix.Contains(ip) && bytes.Equal(bucket.Get(ip.AsSlice()), key) {
+					values[string(key)] = ip
+				}
+				return nil
+			})
+		}
+		return nil
+	})
+	return values
+}
+
+// ReplaceMappings switches from a live memory pool without reviving stale disk entries.
+func (c *FakeIpStore) ReplaceMappings(values map[string]netip.Addr) {
+	if c.DB == nil {
+		return
+	}
+	err := c.DB.Batch(func(t *bbolt.Tx) error {
+		if t.Bucket(c.bucketName) != nil {
+			if err := t.DeleteBucket(c.bucketName); err != nil {
+				return err
+			}
+		}
+		bucket, err := t.CreateBucketIfNotExists(c.bucketName)
+		if err != nil {
+			return err
+		}
+		for host, ip := range values {
+			if err := bucket.Put([]byte(host), ip.AsSlice()); err != nil {
+				return err
+			}
+			if err := bucket.Put(ip.AsSlice(), []byte(host)); err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		log.Warnln("[CacheFile] import fake-ip mappings failed: %s", err)
+	}
+}
+
 func (c *CacheFile) FakeIpStore() *FakeIpStore {
 	return &FakeIpStore{c, bucketFakeip}
 }
