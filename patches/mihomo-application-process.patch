+func TestExcludeTunDNSBeforeListenerStarts(t *testing.T) {
+	tun := LC.Tun{Inet4Address: []netip.Prefix{netip.MustParsePrefix("198.19.8.1/30")}, Inet6Address: []netip.Prefix{netip.MustParsePrefix("fd00::1/126")}}
